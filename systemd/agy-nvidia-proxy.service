[Unit]
Description=LiteLLM proxy translating Antigravity CLI (Gemini) -> NVIDIA APIs
After=network-online.target

[Service]
WorkingDirectory=%h/.config/agy-nvidia
EnvironmentFile=%h/.config/agy-nvidia/.env
ExecStart=%h/.local/bin/litellm --config %h/.config/agy-nvidia/litellm.yaml --port 4000 --host 127.0.0.1
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
