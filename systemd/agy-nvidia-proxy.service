[Unit]
Description=LiteLLM proxy translating Antigravity CLI (Gemini) -> NVIDIA APIs
After=network-online.target

[Service]
WorkingDirectory=%h/.config/agy-nvidia
EnvironmentFile=%h/.config/agy-nvidia/.env
ExecStart=%h/.local/bin/agy-nvidia-router --config %h/.config/agy-nvidia/litellm.yaml
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
